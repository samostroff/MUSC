<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Player 1: Setup</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SR0VG72M7B"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-SR0VG72M7B');
  </script>

  <style>
    body { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem; }
    h1 { font-size: 1.5rem; }
    ul { list-style: none; padding: 0; }
    li { margin: 0.3rem 0; }
    button { margin-left: 0.5rem; }
    .current { font-weight: bold; }
  </style>
</head>
<body>
  <h1>Setup</h1>

  <ul id="track-list"></ul>

  <audio id="audio" controls style="width: 100%; margin-top: 1rem;">
    Your browser does not support the audio element.
  </audio>

  <script>
    // 1) DEFINE YOUR TRACKS HERE
    // For now these are just placeholders; we’ll replace URLs later.
    const tracks = [
      {
        id: 'track1',
        title: 'Speaker Setup',
        url: 'https://samostroff.github.io/MUSC-Audio-Player/audio/VO_Intro.mp3'
      }
    ];

    const audio = document.getElementById('audio');
    const trackList = document.getElementById('track-list');

    let currentTrackIndex = 0;
    let progressMilestonesSent = new Set(); // e.g., 25, 50, 75

    // 2) RENDER TRACK LIST
    function renderTrackList() {
      trackList.innerHTML = '';
      tracks.forEach((track, index) => {
        const li = document.createElement('li');
        li.textContent = track.title;
        if (index === currentTrackIndex) li.classList.add('current');

        const playBtn = document.createElement('button');
        playBtn.textContent = 'Play';
        playBtn.addEventListener('click', () => {
          playTrack(index);
        });

        li.appendChild(playBtn);
        trackList.appendChild(li);
      });
    }

    function updateCurrentTrackHighlight() {
      [...trackList.children].forEach((li, index) => {
        li.classList.toggle('current', index === currentTrackIndex);
      });
    }

    // 3) TRACKING HELPERS
    function sendGAEvent(eventName, params) {
      if (typeof gtag === 'function') {
        gtag('event', eventName, params);
      }
    }

    function sendTrackStartEvent(track) {
      sendGAEvent('track_start', {
        track_id: track.id,
        track_name: track.title
      });
    }

    function sendTrackProgressEvent(track, percent) {
      sendGAEvent('track_progress', {
        track_id: track.id,
        track_name: track.title,
        progress_percent: percent
      });
    }

    function sendTrackCompleteEvent(track) {
      sendGAEvent('track_complete', {
        track_id: track.id,
        track_name: track.title
      });
    }

    // 4) AUDIO CONTROL + GA LOGIC
    function playTrack(index) {
  currentTrackIndex = index;
  const track = tracks[currentTrackIndex];
  progressMilestonesSent.clear();

  audio.pause();
  audio.currentTime = 0;

  audio.src = track.url;
  audio.load();

  const onCanPlay = () => {
    audio.removeEventListener('canplay', onCanPlay);
    audio.play().catch(err => {
      console.warn('Audio play error:', err);
    });
  };
  audio.addEventListener('canplay', onCanPlay);

  updateCurrentTrackHighlight();
  sendTrackStartEvent(track);
}


    // On timeupdate, check progress % and send at 25, 50, 75
    audio.addEventListener('timeupdate', () => {
      if (!audio.duration || isNaN(audio.duration)) return;
      const track = tracks[currentTrackIndex];
      const percent = (audio.currentTime / audio.duration) * 100;

      [25, 50, 75].forEach(milestone => {
        if (percent >= milestone && !progressMilestonesSent.has(milestone)) {
          progressMilestonesSent.add(milestone);
          sendTrackProgressEvent(track, milestone);
        }
      });
    });

    // On ended, send complete and auto-advance (optional)
    audio.addEventListener('ended', () => {
      const track = tracks[currentTrackIndex];
      sendTrackCompleteEvent(track);

      // Optional: auto-play next track
      if (currentTrackIndex < tracks.length - 1) {
        playTrack(currentTrackIndex + 1);
      }
    });

    // INITIALIZE
    renderTrackList();
    if (tracks.length > 0) {
      audio.src = tracks[0].url;
    }
    // SPACEBAR KEYBOARD TOGGLE
window.addEventListener('keydown', (event) => {
  // Ignore if typing in an input/textarea
  const tag = event.target.tagName.toLowerCase();
  if (tag === 'input' || tag === 'textarea') return;

  if (event.code === 'Space' || event.keyCode === 32) {
    event.preventDefault(); // Stop page from scrolling / restarting
    if (audio.paused) {
      audio.play();
    } else {
      audio.pause();
    }
  }
});

  </script>
</body>
</html>






